# Copy to .env and register the apps application in Silicon Accounts first.
APPS_BIND=127.0.0.1:4310
APPS_PUBLIC_URL=http://127.0.0.1:4311
# Both deployed origins must also be registered as Accounts callback URLs.
APPS_ALLOWED_ORIGINS=http://127.0.0.1:4311
APPS_DATA_DIR=.data
APPS_ACCOUNTS_URL=https://accounts.teamofsilicons.com
APPS_ACCOUNTS_APP_SECRET=
APPS_ACCOUNTS_SERVICE_TOKEN=
# On first migration, import the existing Accounts app registry without changing users.
APPS_IMPORT_ACCOUNTS=1
# Historical 1–2 character Accounts app IDs, each creatable only by its owner's
# Accounts UUID: comma-separated app_id:owner_uuid.
# APPS_HISTORICAL_APP_IDS=dm:OWNER_UUID
# Never enable on an externally reachable deployment.
APPS_DEV_AUTH=0

# Independent isolated package runner. A missing runner rejects uploads.
APPS_RUNNER_URL=http://127.0.0.1:4312
APPS_RUNNER_TOKEN=
APPS_RUNNER_TARGETS=macos-aarch64
# Linux runner: pre-pull images and pin digest references in deployment configuration.
# APPS_RUNNER_IMAGES={"linux-x86_64":"debian@sha256:..."}

# Optional custom delivery adapter. By default Accounts handles invitation/report mail.
# APPS_MAIL_URL=https://your-mail-adapter.example/send
# APPS_MAIL_TOKEN=

# Space Station table key is server-only; callers can opt out in settings.
APPS_TELEMETRY_ENABLED=1
APPS_TELEMETRY_TABLE_KEY=
