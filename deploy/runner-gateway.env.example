# Run runner/server.py with this environment on a private gateway host.
# The API uses this gateway's URL/token; each downstream has a separate token.
APPS_RUNNER_HOST=127.0.0.1
APPS_RUNNER_PORT=4312
APPS_RUNNER_TOKEN=REPLACE_WITH_THE_API_GATEWAY_SECRET
APPS_RUNNER_IMAGES={}
# Replace endpoints and tokens; remote workers need a TLS reverse proxy.
# Add only targets with provisioned, verified workers. This JSON must remain one line.
APPS_RUNNER_WORKERS={"macos-aarch64":{"url":"https://mac-arm.worker.example/validate","token":"REPLACE_WITH_MAC_WORKER_SECRET_32_CHARS"},"linux-x86_64":{"url":"https://linux-x64.worker.example/validate","token":"REPLACE_WITH_LINUX_WORKER_SECRET_32_CHARS"}}
