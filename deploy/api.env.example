# Install as /etc/silicon-apps/api.env; keep credentials readable only by the operator.
# This file uses systemd EnvironmentFile syntax, not shell export statements.
APPS_BIND=127.0.0.1:4310
APPS_PUBLIC_URL=https://apps.teamofsilicons.com
APPS_ALLOWED_ORIGINS=https://apps.teamofsilicons.com,https://developers.teamofsilicons.com
APPS_DATA_DIR=/var/lib/silicon-apps
APPS_DEV_AUTH=0
APPS_ACCOUNTS_URL=https://accounts.teamofsilicons.com
APPS_ACCOUNTS_APP_SECRET=REPLACE_WITH_APPS_APP_SECRET
APPS_ACCOUNTS_SERVICE_TOKEN=REPLACE_WITH_ACCOUNTS_INTERNAL_TOKEN
APPS_IMPORT_ACCOUNTS=1

# Historical Silicon Accounts app IDs of 1 or 2 characters (such as dm), which new
# apps cannot use, each reserved for the one Carbon or Silicon allowed to create it:
# comma-separated app_id:owner_uuid, with the owner's case-sensitive Accounts UUID.
# Only that account, signed in, sees the ID as available and can create it; everyone
# else gets the answer for an invalid ID. The API refuses to start on a malformed value.
# APPS_HISTORICAL_APP_IDS=dm:REPLACE_WITH_OWNER_ACCOUNTS_UUID

# Release signing keys, key_id:base64-32-byte-seed, comma separated, newest first. Required:
# the API will not start without one. Production uses apps-2026-10 (pinned in the CLI);
# generate a new key with `apps-server signing-key generate --key-id ID`.
APPS_SIGNING_KEYS=REPLACE_WITH_KEY_ID:BASE64_SEED
# Key IDs CLIs must stop trusting, comma separated.
# APPS_REVOKED_SIGNING_KEYS=

# URL of an authenticated worker or target-routing gateway; no /validate suffix.
# The same bearer secret must be configured at the worker/gateway.
APPS_RUNNER_URL=https://runner.internal.example
APPS_RUNNER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Start with targets that really have isolated execution and were verified.
APPS_RUNNER_TARGETS=linux-x86_64

# Preferred telemetry integration uses the official Space Station client.
APPS_TELEMETRY_ENABLED=true
# APPS_TELEMETRY_TABLE_KEY=REPLACE_WITH_SPACE_STATION_TABLE_KEY
# SPACE_STATION_URL=https://your-space-station.example

# Optional mail override; otherwise use the private Accounts mail bridge.
# APPS_MAIL_URL=https://mail.internal.example/apps
# APPS_MAIL_TOKEN=REPLACE_WITH_ADAPTER_SECRET
# Optional HTTP telemetry adapter, as an alternative to the native table key.
# APPS_TELEMETRY_URL=https://telemetry.internal.example/apps
