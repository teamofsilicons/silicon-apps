[Unit]
Description=Silicon Apps store (server-rendered)
Wants=network-online.target
After=network-online.target silicon-apps-api.service

[Service]
Type=simple
User=silicon-apps-store
Group=silicon-apps-store
WorkingDirectory=/opt/silicon-apps/current/store
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=4320
Environment=APPS_API_URL=http://127.0.0.1:4310
Environment=STORE_PUBLIC_URL=https://apps.teamofsilicons.com
ExecStart=/opt/silicon-apps/current/node/bin/node /opt/silicon-apps/current/store/server.js
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
