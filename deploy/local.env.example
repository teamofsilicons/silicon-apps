# Local development. scripts/dev.sh sources this as shell syntax.
APPS_BIND=127.0.0.1:4310
APPS_PUBLIC_URL=http://127.0.0.1:4311
APPS_ALLOWED_ORIGINS=http://127.0.0.1:4311
APPS_DATA_DIR=.data
APPS_DEV_AUTH=0

# Use a running Silicon Accounts service with the Apps integration.
APPS_ACCOUNTS_URL=http://127.0.0.1:4315
APPS_ACCOUNTS_APP_SECRET=
APPS_ACCOUNTS_SERVICE_TOKEN=
APPS_IMPORT_ACCOUNTS=0

# Leave the token empty to omit the runner. Configure only targets this worker executes.
APPS_RUNNER_URL=http://127.0.0.1:4312
APPS_RUNNER_TOKEN=
APPS_RUNNER_TARGETS=macos-aarch64
APPS_RUNNER_HOST=127.0.0.1
APPS_RUNNER_PORT=4312
APPS_RUNNER_IMAGES='{}'

# The official Accounts private mail bridge is used when APPS_MAIL_URL is absent.
# APPS_MAIL_URL=https://your-private-mail-adapter.example/send
# APPS_MAIL_TOKEN=
APPS_TELEMETRY_ENABLED=true
# APPS_TELEMETRY_TABLE_KEY=
# SPACE_STATION_URL=https://your-space-station.example
