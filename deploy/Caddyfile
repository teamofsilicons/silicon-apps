# The current symlink selects one immutable release: bin/ (API, Caddy), node/, store/ (the
# server-rendered store, a Next.js standalone server on 127.0.0.1:4320) and web/ (the installers).
# The shared developer frontend lives with Accounts at developers.teamofsilicons.com.
developer.teamofsilicons.com {
	map {query.tab} {authoring_section} {
		authors authors
		releases releases
		history history
		default publishing
	}
	@oldApp path_regexp oldApp ^/developer/apps/([a-z0-9_-]+)$
	redir @oldApp https://developers.teamofsilicons.com/apps/{re.oldApp.1}/{authoring_section}?{query} 308
	@oldRoot path /developer /developer/
	redir @oldRoot https://developers.teamofsilicons.com/ 308
	@oldInvites path /developer/invitations
	redir @oldInvites https://developers.teamofsilicons.com/invitations 308
	redir https://developers.teamofsilicons.com{uri} 308
}

apps.teamofsilicons.com {
	map {query.tab} {authoring_section} {
		authors authors
		releases releases
		history history
		default publishing
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@manageApp path_regexp manageApp ^/developer/apps/([a-z0-9_-]+)$
	redir @manageApp https://developers.teamofsilicons.com/apps/{re.manageApp.1}/{authoring_section}?{query} 308
	@manageRoot path /developer /developer/
	redir @manageRoot https://developers.teamofsilicons.com/ 308
	@manageInvites path /developer/invitations
	redir @manageInvites https://developers.teamofsilicons.com/invitations 308
	@docsRoot path /docs /docs/
	redir @docsRoot https://developers.teamofsilicons.com/docs/apps 308
	@docsPage path_regexp docsPage ^/docs/(.+)$
	redir @docsPage https://developers.teamofsilicons.com/docs/apps/{re.docsPage.1}?{query} 308

	# Server-Sent Events: straight to the API, flushed on every write and never compressed.
	@apps_sse path_regexp apps_sse ^/v1/(apps/[^/]+/)?events/stream$
	handle @apps_sse {
		reverse_proxy 127.0.0.1:4310 {
			flush_interval -1
		}
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	}

	# The Apps API and its discovery documents. The event streams above are excluded so the
	# two routes never overlap, whatever order Caddy sorts them in.
	@api {
		path /v1 /v1/* /health /openapi.json /.well-known/agent.json /.well-known/agent-card.json /.well-known/silicon-apps-keys.json
		not path_regexp ^/v1/(apps/[^/]+/)?events/stream$
	}
	handle @api {
		encode zstd gzip
		request_body {
			max_size 180MB
		}
		reverse_proxy 127.0.0.1:4310 {
			# Caddy sets X-Forwarded-Host from the incoming Host by default.
			# No trusted_proxies: client-provided forwarded headers are ignored.
			transport http {
				response_header_timeout 150s
			}
		}
		# The API sets its own caching (private, no-store; discovery documents for 5 minutes).
		header ?Cache-Control "no-store"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	}

	@installers path /install.sh /install.ps1
	handle @installers {
		encode zstd gzip
		root * /opt/silicon-apps/current/web
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		file_server
	}

	# The store's hashed build files are immutable. A missing file is a 404 from disk, never a page.
	handle_path /_next/static/* {
		encode zstd gzip
		root * /opt/silicon-apps/current/store/.next/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the server-rendered store. It sets its own Content-Security-Policy with a
	# fresh nonce per response, so none is set here.
	handle {
		encode zstd gzip
		request_body {
			max_size 2MB
		}
		reverse_proxy 127.0.0.1:4320
	}
}
