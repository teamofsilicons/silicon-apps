# The current symlink selects one immutable release containing web/ and bin/.
# The shared developer frontend lives with Accounts at developers.teamofsilicons.com.
developer.teamofsilicons.com {
	map {query.tab} {authoring_section} {
		authors authors
		releases releases
		history history
		default publishing
	}
	@oldApp path_regexp oldApp ^/developer/apps/([a-z0-9_-]+)$
	redir @oldApp https://developers.teamofsilicons.com/apps/{re.oldApp.1}/{authoring_section}?{query} 308
	@oldRoot path /developer /developer/
	redir @oldRoot https://developers.teamofsilicons.com/ 308
	@oldInvites path /developer/invitations
	redir @oldInvites https://developers.teamofsilicons.com/invitations 308
	redir https://developers.teamofsilicons.com{uri} 308
}

apps.teamofsilicons.com {
	encode zstd gzip
	map {query.tab} {authoring_section} {
		authors authors
		releases releases
		history history
		default publishing
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@manageApp path_regexp manageApp ^/developer/apps/([a-z0-9_-]+)$
	redir @manageApp https://developers.teamofsilicons.com/apps/{re.manageApp.1}/{authoring_section}?{query} 308
	@manageRoot path /developer /developer/
	redir @manageRoot https://developers.teamofsilicons.com/ 308
	@manageInvites path /developer/invitations
	redir @manageInvites https://developers.teamofsilicons.com/invitations 308
	@docsRoot path /docs /docs/
	redir @docsRoot https://developers.teamofsilicons.com/docs/apps 308
	@docsPage path_regexp docsPage ^/docs/(.+)$
	redir @docsPage https://developers.teamofsilicons.com/docs/apps/{re.docsPage.1}?{query} 308

	@api path /v1 /v1/* /health
	handle @api {
		request_body {
			max_size 180MB
		}
		reverse_proxy 127.0.0.1:4310 {
			# Caddy sets X-Forwarded-Host from the incoming Host by default.
			# No trusted_proxies: client-provided forwarded headers are ignored.
			transport http {
				response_header_timeout 150s
			}
		}
		header Cache-Control "no-store"
	}

	@installers path /install.sh /install.ps1
	handle @installers {
		root * /opt/silicon-apps/current/web
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-cache"
		file_server
	}

	# Hashed assets are immutable. A missing asset must return 404, not index.html.
	@assets path /assets/*
	handle @assets {
		root * /opt/silicon-apps/current/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /opt/silicon-apps/current/web
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' https: data:; media-src 'self' https:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
