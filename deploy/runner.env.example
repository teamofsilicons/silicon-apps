# Dedicated Linux validation host. Never provide Accounts or API/database secrets here.
APPS_RUNNER_HOST=127.0.0.1
APPS_RUNNER_PORT=4312
APPS_RUNNER_TOKEN=REPLACE_WITH_THE_API_RUNNER_SECRET
# Replace with operator-selected, pre-pulled immutable image digests.
APPS_RUNNER_IMAGES={"linux-x86_64":"registry.example/apps-validator@sha256:REPLACE_WITH_DIGEST"}
# For Docker mounting, scratch files must be visible at this same host path.
TMPDIR=/var/lib/silicon-apps-runner/jobs
# A rootless engine may require a configured DOCKER_HOST.
